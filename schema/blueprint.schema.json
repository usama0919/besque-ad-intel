{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CreativeBlueprint",
  "type": "object",
  "required": ["ad_id", "source_page", "captured_at", "format", "hook", "awareness_stage", "claims", "visual", "cta", "structural_zones", "production_style", "body_area_shown", "face_present", "semantic_split", "scene_elements", "testimonial_zones", "text_purpose"],
  "properties": {
    "ad_id": { "type": "string" },
    "source_page": { "type": "string" },
    "captured_at": { "type": "string" },
    "format": { "type": "string" },
    "hook": {
      "type": "object",
      "required": ["type", "headline_structure"],
      "properties": {
        "type": { "type": "string" },
        "headline_structure": { "type": "string" }
      }
    },
    "angle": { "type": "string" },
    "awareness_stage": {
      "type": "string",
      "enum": ["unaware", "problem", "solution", "product", "most_aware"]
    },
    "claims": {
      "type": "array",
      "items": { "type": "string", "enum": ["efficacy", "sensory", "ingredient", "social_proof", "offer"] }
    },
    "visual": {
      "type": "object",
      "required": ["layout", "subject", "palette_mood", "text_placement"],
      "properties": {
        "layout": { "type": "string" },
        "subject": { "type": "string" },
        "palette_mood": { "type": "string" },
        "text_placement": { "type": "string" },
        "scene_lighting": {
          "type": ["object", "null"],
          "properties": {
            "light_direction": { "type": "string" },
            "hardness": { "type": "string", "enum": ["hard", "soft"] },
            "colour_temperature": { "type": "string" },
            "shadow_behaviour": { "type": "string" },
            "grain": { "type": "string" },
            "depth_of_field": { "type": "string" }
          }
        }
      }
    },
    "cta": { "type": "string" },
    "destination_url": { "type": "string" },
    "headline_verbatim": { "type": "string" },
    "offer": {
      "type": ["object", "null"],
      "properties": {
        "type": { "type": "string" },
        "value": { "type": "string" },
        "mechanic": { "type": "string" }
      }
    },
    "social_proof": {
      "type": ["object", "null"],
      "properties": {
        "type": { "type": "string" },
        "owner": { "type": "string" }
      }
    },
    "layout_detail": {
      "type": "object",
      "properties": {
        "text_zone": { "type": "string" },
        "product_count": { "type": "number" },
        "background_type": { "type": "string" },
        "zone_positions": { "type": "array", "items": { "type": "string" } },
        "has_bottom_banner": { "type": "boolean" },
        "has_corner_badge": { "type": "boolean" },
        "frame_division": { "type": "string" }
      }
    },
    "legibility_notes": { "type": "string" },
    "body_area_shown": { "type": "string" },
    "creative_objective": { "type": "string" },
    "target_audience": { "type": "string" },
    "typography": {
      "type": ["object", "null"],
      "properties": {
        "headline_face": { "type": "string" },
        "headline_weight": { "type": "string" },
        "hierarchy_levels": { "type": "array", "items": { "type": "string" } },
        "case_treatment": { "type": "string" }
      }
    },
    "typography_zones": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "zone": { "type": "string" },
          "typeface_class": { "type": "string" },
          "weight": { "type": "string" },
          "case": { "type": "string" },
          "letter_spacing": { "type": "string" },
          "colour": { "type": "string" },
          "size_relative": { "type": "string" },
          "decorative_elements": { "type": "array", "items": { "type": "string" } },
          "line_count": { "type": "number" }
        }
      }
    },
    "structural_zones": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "zone_type": {
            "type": "string",
            "enum": [
              "brand_wordmark", "sub_line", "body_copy", "cta", "price_anchor",
              "product_callout", "badge", "social_proof", "disclaimer"
            ]
          },
          "position": { "type": "string" },
          "container": {
            "type": "string",
            "enum": ["none", "oval", "rect", "banner", "ribbon", "other"]
          },
          "detail": { "type": "string" },
          "social_proof_kind": {
            "type": ["string", "null"],
            "enum": ["aggregate_bar", "single_quote", null]
          }
        }
      }
    },
    "production_style": {
      "type": "object",
      "properties": {
        "style": { "type": "string", "enum": ["ugc", "high_spec", "illustrated"] },
        "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
        "signals": { "type": "array", "items": { "type": "string" } }
      }
    },
    "face_present": {
      "type": "object",
      "required": ["has_face", "prominence", "location"],
      "properties": {
        "has_face": { "type": "boolean" },
        "prominence": { "type": "string", "enum": ["primary", "incidental", "none"] },
        "location": { "type": "string" }
      }
    },
    "semantic_split": {
      "type": "object",
      "required": ["is_split", "split_axis", "left_or_before", "right_or_after"],
      "properties": {
        "is_split": { "type": "boolean" },
        "split_axis": { "type": ["string", "null"], "enum": ["vertical", "horizontal", null] },
        "left_or_before": { "type": "string" },
        "right_or_after": { "type": "string" }
      }
    },
    "scene_elements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["element", "role", "essential"],
        "properties": {
          "element": { "type": "string" },
          "role": { "type": "string" },
          "essential": { "type": "boolean" }
        }
      }
    },
    "testimonial_zones": {
      "$comment": "NAMING CONSTRAINT: if generate_copy.py ever gains a testimonial output field, it must be named exactly \"testimonial\" to match TESTIMONIAL_FIELD_KEYS in src/compliance.py - that check only scans keys named in that tuple, and a differently-named field would silently bypass the fabricated-testimonial guard the same way an absent one does today.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text_verbatim", "attribution", "placement", "styling"],
        "properties": {
          "text_verbatim": { "type": "string" },
          "attribution": { "type": "string" },
          "placement": { "type": "string" },
          "styling": { "type": "string" }
        }
      }
    },
    "text_purpose": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text_verbatim", "purpose", "placement"],
        "properties": {
          "text_verbatim": { "type": "string" },
          "purpose": {
            "type": "string",
            "enum": ["offer", "testimonial", "efficacy_claim", "problem_hook", "product_description", "cta", "other"]
          },
          "placement": { "type": "string" }
        }
      }
    },
    "creative_format": {
      "type": "string",
      "enum": [
        "testimonial_review", "before_after", "problem_solution", "product_hero",
        "offer_led", "comparison", "listicle_tips", "founder_story",
        "ingredient_focus", "lifestyle_scene", "text_led_editorial"
      ]
    },
    "product_category": {
      "type": "object",
      "properties": {
        "category": {
          "type": "string",
          "enum": [
            "body_oil", "face_oil", "serum", "moisturiser", "cleanser",
            "haircare", "supplement", "firming", "other", "not_product"
          ]
        },
        "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
        "signals": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}