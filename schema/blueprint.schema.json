{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CreativeBlueprint",
  "type": "object",
  "required": ["ad_id", "source_page", "captured_at", "format", "hook", "awareness_stage", "claims", "visual", "cta"],
  "properties": {
    "ad_id": { "type": "string" },
    "source_page": { "type": "string" },
    "captured_at": { "type": "string" },
    "format": { "type": "string" },
    "hook": {
      "type": "object",
      "required": ["type", "headline_structure"],
      "properties": {
        "type": { "type": "string" },
        "headline_structure": { "type": "string" }
      }
    },
    "angle": { "type": "string" },
    "awareness_stage": {
      "type": "string",
      "enum": ["unaware", "problem", "solution", "product", "most_aware"]
    },
    "claims": {
      "type": "array",
      "items": { "type": "string", "enum": ["efficacy", "sensory", "ingredient", "social_proof", "offer"] }
    },
    "visual": {
      "type": "object",
      "required": ["layout", "subject", "palette_mood", "text_placement"],
      "properties": {
        "layout": { "type": "string" },
        "subject": { "type": "string" },
        "palette_mood": { "type": "string" },
        "text_placement": { "type": "string" }
      }
    },
    "cta": { "type": "string" },
    "destination_url": { "type": "string" },
    "headline_verbatim": { "type": "string" },
    "offer": {
      "type": ["object", "null"],
      "properties": {
        "type": { "type": "string" },
        "value": { "type": "string" },
        "mechanic": { "type": "string" }
      }
    },
    "social_proof": {
      "type": ["object", "null"],
      "properties": {
        "type": { "type": "string" },
        "owner": { "type": "string" }
      }
    },
    "layout_detail": {
      "type": "object",
      "properties": {
        "text_zone": { "type": "string" },
        "product_count": { "type": "number" },
        "background_type": { "type": "string" }
      }
    },
    "legibility_notes": { "type": "string" },
    "production_style": {
      "type": "object",
      "properties": {
        "style": { "type": "string", "enum": ["ugc_native", "high_spec_studio", "hybrid", "illustrated"] },
        "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
        "signals": { "type": "array", "items": { "type": "string" } }
      }
    },
    "creative_format": {
      "type": "string",
      "enum": [
        "testimonial_review", "before_after", "problem_solution", "product_hero",
        "offer_led", "comparison", "listicle_tips", "founder_story",
        "ingredient_focus", "lifestyle_scene", "text_led_editorial"
      ]
    },
    "product_category": {
      "type": "object",
      "properties": {
        "category": {
          "type": "string",
          "enum": [
            "body_oil", "face_oil", "serum", "moisturiser", "cleanser",
            "haircare", "supplement", "firming", "other", "not_product"
          ]
        },
        "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
        "signals": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}