{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CreativeBlueprint",
  "type": "object",
  "required": ["ad_id", "source_page", "captured_at", "format", "hook", "awareness_stage", "claims", "visual", "cta", "objects", "background", "production_style", "body_area_shown", "face_present", "semantic_split"],
  "properties": {
    "ad_id": { "type": "string" },
    "source_page": { "type": "string" },
    "captured_at": { "type": "string" },
    "format": { "type": "string" },
    "hook": {
      "type": "object",
      "required": ["type", "headline_structure"],
      "properties": {
        "type": { "type": "string" },
        "headline_structure": { "type": "string" }
      }
    },
    "angle": { "type": "string" },
    "awareness_stage": {
      "type": "string",
      "enum": ["unaware", "problem", "solution", "product", "most_aware"]
    },
    "claims": {
      "type": "array",
      "items": { "type": "string", "enum": ["efficacy", "sensory", "ingredient", "social_proof", "offer"] }
    },
    "visual": {
      "type": "object",
      "required": ["layout", "subject", "palette_mood", "text_placement"],
      "properties": {
        "layout": { "type": "string" },
        "subject": { "type": "string" },
        "palette_mood": { "type": "string" },
        "text_placement": { "type": "string" }
      }
    },
    "background": {
      "type": "object",
      "required": ["surface", "colour", "light"],
      "properties": {
        "surface": { "type": "string" },
        "colour": { "type": "string" },
        "light": { "type": "string" }
      }
    },
    "objects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["object_id", "kind", "description", "bbox", "colours", "ownership",
                     "role", "carries_brand_mark", "persuasive_function", "disposition"],
        "properties": {
          "object_id": { "type": "string" },
          "kind": {
            "type": "string",
            "enum": ["product", "person", "text", "logo", "prop", "surface", "graphic"]
          },
          "description": { "type": "string" },
          "bbox": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": { "type": "number", "minimum": 0, "maximum": 1 }
          },
          "colours": { "type": "array", "items": { "type": "string" } },
          "ownership": {
            "type": "string",
            "enum": ["competitor_branded", "generic", "besque", "person"]
          },
          "role": {
            "type": "string",
            "enum": ["hero", "secondary", "supporting_prop", "environment"]
          },
          "carries_brand_mark": { "type": "boolean" },
          "persuasive_function": { "type": "string" },
          "disposition": {
            "type": "string",
            "enum": ["substitute", "keep", "drop"]
          },
          "text_purpose": {
            "type": "string",
            "enum": ["headline", "subtext", "cta", "offer", "certification", "testimonial",
                     "price_anchor", "award", "disclaimer", "product_callout", "other"]
          }
        },
        "if": { "properties": { "kind": { "const": "text" } } },
        "then": { "required": ["text_purpose"] }
      }
    },
    "cta": { "type": "string" },
    "destination_url": { "type": "string" },
    "headline_verbatim": { "type": "string" },
    "offer": {
      "type": ["object", "null"],
      "properties": {
        "type": { "type": "string" },
        "value": { "type": "string" },
        "mechanic": { "type": "string" }
      }
    },
    "social_proof": {
      "type": ["object", "null"],
      "properties": {
        "type": { "type": "string" },
        "owner": { "type": "string" }
      }
    },
    "layout_detail": {
      "type": "object",
      "properties": {
        "text_zone": { "type": "string" },
        "product_count": { "type": "number" },
        "zone_positions": { "type": "array", "items": { "type": "string" } },
        "has_bottom_banner": { "type": "boolean" },
        "has_corner_badge": { "type": "boolean" },
        "frame_division": { "type": "string" }
      }
    },
    "legibility_notes": { "type": "string" },
    "body_area_shown": { "type": "string" },
    "creative_objective": { "type": "string" },
    "target_audience": { "type": "string" },
    "typography": {
      "type": ["object", "null"],
      "properties": {
        "headline_face": { "type": "string" },
        "headline_weight": { "type": "string" },
        "hierarchy_levels": { "type": "array", "items": { "type": "string" } },
        "case_treatment": { "type": "string" }
      }
    },
    "production_style": {
      "type": "object",
      "properties": {
        "style": { "type": "string", "enum": ["ugc", "high_spec", "illustrated"] },
        "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
        "signals": { "type": "array", "items": { "type": "string" } }
      }
    },
    "face_present": {
      "type": "object",
      "required": ["has_face", "prominence", "location"],
      "properties": {
        "has_face": { "type": "boolean" },
        "prominence": { "type": "string", "enum": ["primary", "incidental", "none"] },
        "location": { "type": "string" }
      }
    },
    "semantic_split": {
      "type": "object",
      "required": ["is_split", "split_axis", "left_or_before", "right_or_after"],
      "properties": {
        "is_split": { "type": "boolean" },
        "split_axis": { "type": ["string", "null"], "enum": ["vertical", "horizontal", null] },
        "left_or_before": { "type": "string" },
        "right_or_after": { "type": "string" }
      }
    },
    "creative_format": {
      "type": "string",
      "enum": [
        "testimonial_review", "before_after", "problem_solution", "product_hero",
        "offer_led", "comparison", "listicle_tips", "founder_story",
        "ingredient_focus", "lifestyle_scene", "text_led_editorial"
      ]
    },
    "product_category": {
      "type": "object",
      "properties": {
        "category": {
          "type": "string",
          "enum": [
            "body_oil", "face_oil", "serum", "moisturiser", "cleanser",
            "haircare", "supplement", "firming", "other", "not_product"
          ]
        },
        "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
        "signals": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}